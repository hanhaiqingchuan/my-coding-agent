{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/my-coding-agent/evaluation/schemas/summary-v1.schema.json",
  "title": "summary-v1",
  "description": "Redacted campaign aggregate. Harness outcomes stay out of the capability denominator, token totals stay null whenever any run is missing provider usage, and judge aggregates are reported beside the deterministic metrics without ever entering strict_success.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "agent_commit",
    "model_identity",
    "provider",
    "started_runs",
    "valid_runs",
    "harness_setup_runs",
    "harness_oracle_error_runs",
    "strict_success_runs",
    "artifact_correct_runs",
    "artifact_correct_only_runs",
    "task_completion_rate",
    "robust_task_count",
    "total_input_tokens",
    "total_output_tokens",
    "total_cache_creation_input_tokens",
    "total_cache_read_input_tokens",
    "usage_coverage",
    "judged_runs",
    "judge_error_runs",
    "judge_means",
    "judge_coverage",
    "tasks"
  ],
  "properties": {
    "schema_version": { "const": "summary-v1" },
    "campaign_id": { "type": ["string", "null"] },
    "agent_commit": { "type": ["string", "null"] },
    "model_identity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "The single model identity every run in this campaign recorded. Null when no run recorded one, or when the runs disagree — a campaign that mixed models must not be labelled with one.",
      "properties": {
        "name": { "type": ["string", "null"] },
        "context_window": { "type": ["integer", "null"] },
        "max_output_tokens": { "type": ["integer", "null"] },
        "stream": { "type": ["boolean", "null"] }
      }
    },
    "provider": { "const": "anthropic_messages" },
    "started_runs": { "type": "integer", "minimum": 0 },
    "valid_runs": {
      "type": "integer",
      "minimum": 0,
      "description": "Started runs minus HARNESS_SETUP and HARNESS_ORACLE_ERROR outcomes."
    },
    "harness_setup_runs": { "type": "integer", "minimum": 0 },
    "harness_oracle_error_runs": { "type": "integer", "minimum": 0 },
    "strict_success_runs": { "type": "integer", "minimum": 0 },
    "artifact_correct_runs": { "type": "integer", "minimum": 0 },
    "artifact_correct_only_runs": { "type": "integer", "minimum": 0 },
    "task_completion_rate": {
      "type": ["number", "null"],
      "description": "strict_success_runs / valid_runs; null when there is no valid run."
    },
    "robust_task_count": { "type": "integer", "minimum": 0 },
    "total_input_tokens": { "type": ["integer", "null"] },
    "total_output_tokens": { "type": ["integer", "null"] },
    "total_cache_creation_input_tokens": { "type": ["integer", "null"] },
    "total_cache_read_input_tokens": { "type": ["integer", "null"] },
    "usage_coverage": { "type": ["number", "null"] },
    "total_main_requests": { "type": "integer", "minimum": 0 },
    "total_compaction_requests": { "type": "integer", "minimum": 0 },
    "total_attempts": { "type": "integer", "minimum": 0 },
    "total_network_retries": { "type": "integer", "minimum": 0 },
    "tools": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "compaction_runs": { "type": "integer", "minimum": 0 },
    "agent_monotonic_ms": {
      "type": "object",
      "additionalProperties": { "type": ["number", "null"] }
    },
    "failure_kinds": {
      "type": "object",
      "description": "Counts of the recorded run-v1 failure kinds. The vocabulary is the fixed set of section 18.5 and matches run-v1's failure_kind enum; a kind nobody recorded is absent rather than reported as zero.",
      "propertyNames": {
        "enum": [
          "harness_setup",
          "harness_oracle",
          "model_auth",
          "model_transport",
          "model_protocol",
          "model_refusal",
          "pause_turn",
          "context_overflow",
          "output_truncated",
          "max_rounds",
          "doom_loop",
          "tool_argument",
          "tool_path",
          "tool_execution",
          "command_timeout",
          "write_conflict",
          "forbidden_modification",
          "oracle_failure",
          "unknown"
        ]
      },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "judged_runs": {
      "type": "integer",
      "minimum": 0,
      "description": "Runs carrying a judgement-v1 record, judge errors included."
    },
    "judge_error_runs": {
      "type": "integer",
      "minimum": 0,
      "description": "Judged runs whose record is a judge_error rather than a score. Judge errors never abort a campaign and never enter strict_success."
    },
    "judge_means": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mean of each fuzzy score over the successfully judged runs; a score stays null when no judgement carries it.",
      "required": ["task_completion", "process_quality", "communication"],
      "properties": {
        "task_completion": { "type": ["number", "null"] },
        "process_quality": { "type": ["number", "null"] },
        "communication": { "type": ["number", "null"] }
      }
    },
    "judge_coverage": {
      "type": ["number", "null"],
      "description": "judged_runs / started_runs; null when the campaign started no run. Zero for a campaign that ran without the judge."
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "category", "valid_runs", "strict_success_runs", "results"],
        "properties": {
          "task_id": { "type": "string" },
          "category": { "type": "string" },
          "started_runs": { "type": "integer", "minimum": 0 },
          "valid_runs": { "type": "integer", "minimum": 0 },
          "strict_success_runs": { "type": "integer", "minimum": 0 },
          "artifact_correct_runs": { "type": "integer", "minimum": 0 },
          "results": {
            "type": "array",
            "items": { "type": "boolean" },
            "description": "Per-repeat strict success flags, kept raw instead of averaged."
          },
          "robust": { "type": "boolean" }
        }
      }
    }
  }
}
