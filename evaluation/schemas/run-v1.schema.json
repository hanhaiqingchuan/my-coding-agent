{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/my-coding-agent/evaluation/schemas/run-v1.schema.json",
  "title": "run-v1",
  "description": "One immutable evaluation run. Harness facts plus the agent's own run-report-v1 projection. Contains no prompt text, tool arguments, command output, transcript, or absolute paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "task_id",
    "category",
    "repeat",
    "provider",
    "agent_commit",
    "outcome",
    "strict_success",
    "artifact_correct",
    "state",
    "stop_reason",
    "error_kind",
    "failure_stage",
    "failure_kind",
    "hashes",
    "model",
    "tools",
    "compaction",
    "oracle",
    "modifications",
    "durations",
    "agent_report"
  ],
  "properties": {
    "schema_version": { "const": "run-v1" },
    "campaign_id": { "type": "string" },
    "task_id": { "type": "string" },
    "category": {
      "enum": ["new_file", "local_edit", "locate_and_modify", "large_file_edit"]
    },
    "repeat": { "type": "integer", "minimum": 1 },
    "provider": { "const": "anthropic_messages" },
    "agent_commit": { "type": ["string", "null"] },
    "outcome": { "enum": ["OK", "HARNESS_SETUP", "HARNESS_ORACLE_ERROR"] },
    "strict_success": { "type": "boolean" },
    "artifact_correct": { "type": "boolean" },
    "state": { "type": ["string", "null"] },
    "stop_reason": { "type": ["string", "null"] },
    "error_kind": { "type": ["string", "null"] },
    "failure_stage": {
      "enum": ["setup", "model", "agent", "tool", "oracle", null]
    },
    "failure_kind": {
      "enum": [
        "harness_setup",
        "harness_oracle",
        "model_auth",
        "model_transport",
        "model_protocol",
        "model_refusal",
        "pause_turn",
        "context_overflow",
        "output_truncated",
        "max_rounds",
        "doom_loop",
        "tool_argument",
        "tool_path",
        "tool_execution",
        "command_timeout",
        "write_conflict",
        "forbidden_modification",
        "oracle_failure",
        "unknown",
        null
      ]
    },
    "harness_detail": { "type": ["string", "null"] },
    "agent_exit_code": { "type": ["integer", "null"] },
    "agent_timed_out": { "type": "boolean" },
    "agent_argv_options": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The frozen headless option names; concrete paths are never exported."
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "task",
        "prompt",
        "tool_schema",
        "baseline_tree",
        "workspace_tree",
        "diff"
      ],
      "properties": {
        "config": { "type": ["string", "null"] },
        "task": { "type": ["string", "null"] },
        "prompt": { "type": ["string", "null"] },
        "tool_schema": {
          "type": ["string", "null"],
          "description": "sha256 over the canonical Anthropic {name, description, input_schema} wire structure."
        },
        "baseline_tree": { "type": ["string", "null"] },
        "workspace_tree": { "type": ["string", "null"] },
        "diff": { "type": ["string", "null"] }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usage", "main_requests", "compaction_requests", "attempts"],
      "properties": {
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "description": "Provider usage only; a missing component stays null and is never estimated locally.",
          "required": [
            "input_tokens",
            "output_tokens",
            "cache_creation_input_tokens",
            "cache_read_input_tokens"
          ],
          "properties": {
            "input_tokens": { "type": ["integer", "null"] },
            "output_tokens": { "type": ["integer", "null"] },
            "cache_creation_input_tokens": { "type": ["integer", "null"] },
            "cache_read_input_tokens": { "type": ["integer", "null"] }
          }
        },
        "main_requests": { "type": "integer", "minimum": 0 },
        "compaction_requests": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "integer", "minimum": 0 },
        "network_retries": { "type": "integer", "minimum": 0 },
        "usage_coverage": { "type": ["number", "null"] }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed", "executed", "succeeded", "failed", "skipped"],
      "properties": {
        "proposed": { "type": "integer", "minimum": 0 },
        "executed": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "duplicate_calls": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "integer", "minimum": 0 },
        "output_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "requests", "above_target"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "requests": { "type": "integer", "minimum": 0 },
        "above_target": { "type": "boolean" },
        "input_tokens_before": { "type": ["integer", "null"] },
        "input_tokens_after": { "type": ["integer", "null"] },
        "estimated_summary_tokens": { "type": ["integer", "null"] },
        "provider_summary_output_tokens": { "type": ["integer", "null"] },
        "estimated_minus_provider_tokens": { "type": ["integer", "null"] }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "regression"],
      "properties": {
        "target": { "$ref": "#/$defs/oracleOutcome" },
        "regression": { "$ref": "#/$defs/oracleOutcome" }
      }
    },
    "modifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_added",
        "files_modified",
        "files_deleted",
        "lines_added",
        "lines_removed",
        "forbidden_paths_modified",
        "detected_workspace_escape"
      ],
      "properties": {
        "files_added": { "type": "integer", "minimum": 0 },
        "files_modified": { "type": "integer", "minimum": 0 },
        "files_deleted": { "type": "integer", "minimum": 0 },
        "lines_added": { "type": "integer", "minimum": 0 },
        "lines_removed": { "type": "integer", "minimum": 0 },
        "out_of_scope_paths": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths_modified": { "type": "array", "items": { "type": "string" } },
        "detected_workspace_escape": { "type": "boolean" }
      }
    },
    "durations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every duration is derived from a monotonic clock.",
      "required": ["workspace_prepare_ms", "agent_process_ms", "oracle_ms", "total_ms"],
      "properties": {
        "workspace_prepare_ms": { "type": "integer", "minimum": 0 },
        "agent_process_ms": { "type": "integer", "minimum": 0 },
        "oracle_ms": { "type": "integer", "minimum": 0 },
        "total_ms": { "type": "integer", "minimum": 0 },
        "agent_monotonic_ms": { "type": ["integer", "null"] },
        "retry_wait_monotonic_ms": { "type": ["integer", "null"] },
        "tool_execution_monotonic_ms": { "type": ["integer", "null"] }
      }
    },
    "agent_report": {
      "type": "object",
      "description": "The agent-side run-report-v1 document, embedded verbatim and never re-derived."
    },
    "started_at": { "type": ["string", "null"] },
    "finished_at": { "type": ["string", "null"] }
  },
  "$defs": {
    "oracleOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "exit_code", "duration_ms", "errored"],
      "properties": {
        "passed": { "type": ["boolean", "null"] },
        "exit_code": { "type": ["integer", "null"] },
        "duration_ms": { "type": ["integer", "null"] },
        "errored": { "type": "boolean" }
      }
    }
  }
}
