{
  "allowed": [
    {
      "command": "PYTHONPATH=src python3 -B -m unittest discover -s tests -t tests",
      "cwd": "."
    },
    {
      "command": "ls",
      "cwd": "."
    },
    {
      "command": "ls -la",
      "cwd": "."
    },
    {
      "command": "pwd",
      "cwd": "."
    },
    {
      "command": "find . -maxdepth 3 -type f -not -path './.git/*' | sort",
      "cwd": "."
    }
  ],
  "schema_version": "command-policy-v1"
}
